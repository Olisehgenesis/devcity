generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id
  walletAddress     String?              @unique
  username          String?              @unique
  name              String?
  email             String?              @unique
  emailVerified     Boolean              @default(false)
  image             String?
  avatarUrl         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accounts          Account[]
  sessions          Session[]
  passkeys          Passkey[]
  profile           Profile?
  presence          Presence?
  messages          Message[]
  memberships       ConversationMember[]
  eventMemberships  EventMember[]
  claims            DropClaim[]
  createdTokens     Token[]
  createdDrops      Drop[]
  broadcasts        Broadcast[]
  broadcastLikes    BroadcastLike[]
  broadcastComments BroadcastComment[]
  broadcastReactions BroadcastReaction[]
  tipsSent          Tip[]                @relation("TipFrom")
  tipsReceived      Tip[]                @relation("TipTo")
  stories           Story[]
  activity          Activity[]
  avatarSettings    AvatarSettings?
  userSettings      UserSettings?
  syncedActivity    UserActivity[]
  eventRsvps        EventRsvp[]
  eventMessages     EventMessage[]
  notifications     Notification[]
  drafts            BroadcastDraft[]
stalls            Stall[]
   booths            Booth[]
   following         Follow[]              @relation("FollowFollower")
   followers         Follow[]              @relation("FollowFollowing")
   friendRequestsSent     FriendRequest[]  @relation("FriendRequestFrom")
   friendRequestsReceived FriendRequest[]  @relation("FriendRequestTo")
   walletBackups     WalletBackup[]
   game              GameProfile?

   @@map("users")
}

// Cosmetic, non-financial game layer (streak, badges, sticker album).
// Stored in the database and keyed to a user so progress follows the account.
// Progression is derived from REAL on-chain/DB activity (claims, tips, drops,
// events), never from fake points. GameProfile itself holds no value.
model GameProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  streak            Int      @default(0)
  lastVisitDay      String?
  badges            String[] @default([])
  stickers          Json     @default("{}")
  leaderboardsOptIn Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leaderboardsOptIn, updatedAt])
  @@map("game_profiles")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Passkey {
  id           String   @id
  name         String?
  publicKey    String
  userId       String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Profile {
  id            String         @id @default(cuid())
  userId        String         @unique
  username      String         @unique
  displayName   String?
  bio           String?        @db.VarChar(280)
  avatarUrl     String?
  visibility    VisibilityMode @default(APPROXIMATE)
  privacy       ProfilePrivacy @default(PUBLIC)
  presence      PresenceStatus @default(ONLINE)
  presenceUntil DateTime?
  identityVerifiedAt DateTime?
  selfNullifier String?        @unique
  locationSharing Boolean      @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallets       Wallet[]

  @@map("profiles")
}

model Wallet {
  id         String    @id @default(cuid())
  profileId  String
  address    String
  chainId    Int
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([chainId, address])
  @@index([profileId])
  @@map("wallets")
}

// Opt-in encrypted cloud backup of a client-side wallet key.
// Stores ONLY the client-encrypted blob (AES-GCM ciphertext + KDF params).
// The server never sees the private key or the passphrase.
// `userId` lets an authenticated session restore its wallet on a new device
// without the client having to remember the wallet address.
model WalletBackup {
  id         String   @id @default(cuid())
  userId     String
  address    String   @unique
  iv         String
  data       String   @db.Text
  salt       String
  iterations Int      @default(250000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_backups")
}

model CityEvent {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  centerLat   Decimal       @db.Decimal(9, 6)
  centerLng   Decimal       @db.Decimal(9, 6)
  radiusM     Int?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     EventMember[]
  drops       Drop[]
  places      Place[]
  booths      Booth[]

  @@index([isActive, startsAt])
  @@map("city_events")
}

model EventMember {
  eventId  String
  userId   String
  joinedAt DateTime  @default(now())
  event    CityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_members")
}

model Place {
  id          String     @id @default(cuid())
  eventId     String?
  name        String
  description String?
  category    String
  latitude    Decimal    @db.Decimal(9, 6)
  longitude   Decimal    @db.Decimal(9, 6)
  source      String     @default("organizer")
  externalId  String?
  createdAt   DateTime   @default(now())
  event       CityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  drops       Drop[]

  @@unique([source, externalId])
  @@index([latitude, longitude])
  @@index([eventId])
  @@map("places")
}

model Event {
  id         String          @id @default(cuid())
  slug       String          @unique
  name       String
  organizer  String
  summary    String?
  category   String?
  kind       String?
  region     String?
  location   String?
  imageUrl   String?
  latitude    Float?
  longitude   Float?
  online     Boolean         @default(false)
  startDate  DateTime?       @db.Date
  endDate    DateTime?       @db.Date
  startTime  String?
  endTime    String?
  url        String?
  source     String          @default("krew3")
  externalId String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  timetable  TimetableSlot[]
  rsvps      EventRsvp[]
  messages   EventMessage[]

  @@unique([source, externalId])
  @@index([startDate])
  @@index([region, category])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("going") // going, interested, attended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

model EventMessage {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
  @@map("event_messages")
}

model TimetableSlot {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  dayNumber Int      @default(1)
  label     String?
  startTime String?
  endTime   String?
  allDay    Boolean  @default(false)
  title     String?
  createdAt DateTime @default(now())

  @@unique([eventId, date])
  @@index([date])
  @@map("timetable_slots")
}

model Token {
  id              String      @id @default(cuid())
  creatorId       String
  name            String
  symbol          String
  description     String?
  iconUrl         String?
  chainId         Int
  contractAddress String?
  decimals       Int         @default(18)
  maxSupply       Decimal     @db.Decimal(78, 0)
  createdAt       DateTime    @default(now())
  creator         User        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  drops           Drop[]
  claims          DropClaim[]
  tips            Tip[]

  @@unique([chainId, contractAddress])
  @@index([creatorId])
  @@map("tokens")
}

model Drop {
  id               String      @id @default(cuid())
  creatorId        String
  eventId          String?
  placeId          String?
  tokenId          String
  name             String
  description      String?
  amount           Decimal     @db.Decimal(78, 0)
  maxClaimants     Int
  currentClaimants Int         @default(0)
  radius           Float       @default(0.5)
  startsAt         DateTime
  expiresAt        DateTime
  status           DropStatus  @default(DRAFT)
  latitude         Decimal?    @db.Decimal(9, 6)
  longitude        Decimal?    @db.Decimal(9, 6)
  qrPayloadHash    String?     @unique
  qrExpiresAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  creator          User        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  event            CityEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  place            Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  token            Token       @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  claims           DropClaim[]

  @@index([eventId, status, startsAt, expiresAt])
  @@index([latitude, longitude])
  @@index([creatorId])
  @@map("drops")
}

model DropClaim {
  id        String      @id @default(cuid())
  dropId    String
  userId    String
  tokenId   String?
  amount    Decimal     @db.Decimal(78, 0)
  status    ClaimStatus @default(PENDING)
  txHash    String?     @unique
  claimedAt DateTime    @default(now())
  drop      Drop        @relation(fields: [dropId], references: [id], onDelete: Restrict)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  token     Token?      @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@unique([dropId, userId])
  @@index([userId, claimedAt])
  @@map("drop_claims")
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(4000)
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Broadcast {
  id                String             @id @default(cuid())
  userId            String
  text              String             @db.VarChar(240)
  mediaUrl          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcastLikes    BroadcastLike[]
  broadcastComments BroadcastComment[]
  broadcastReactions BroadcastReaction[]
  broadcastHashtags BroadcastHashtag[]

  @@index([userId, createdAt])
  @@map("broadcasts")
}

model BroadcastLike {
  broadcastId String
  userId      String
  createdAt   DateTime  @default(now())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([broadcastId, userId])
  @@index([userId, createdAt])
  @@map("broadcast_likes")
}

model BroadcastComment {
  id          String             @id @default(cuid())
  broadcastId String
  userId      String
  parentId    String?
  text        String             @db.VarChar(240)
  createdAt   DateTime           @default(now())
  broadcast   Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      BroadcastComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     BroadcastComment[] @relation("CommentReplies")

  @@index([broadcastId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
  @@map("broadcast_comments")
}

model BroadcastDraft {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.VarChar(240)
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("broadcast_drafts")
}

model BroadcastReaction {
  id          String   @id @default(cuid())
  broadcastId String
  userId      String
  emoji       String   @db.VarChar(50)
  createdAt   DateTime @default(now())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId, emoji])
  @@index([broadcastId])
  @@index([userId])
  @@map("broadcast_reactions")
}

model Presence {
  id          String         @id @default(cuid())
  userId      String         @unique
  latitude    Decimal        @db.Decimal(9, 6)
  longitude   Decimal        @db.Decimal(9, 6)
  visibility  VisibilityMode @default(APPROXIMATE)
  status      PresenceStatus @default(OFFLINE)
  lastUpdated DateTime       @default(now())
  expiresAt   DateTime
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("presence")
}

model Tip {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  tokenId    String
  amount     Decimal  @db.Decimal(78, 0)
  message    String?  @db.VarChar(280)
  txHash     String?  @unique
  createdAt  DateTime @default(now())
  fromUser   User     @relation("TipFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser     User     @relation("TipTo", fields: [toUserId], references: [id], onDelete: Restrict)
  token      Token    @relation(fields: [tokenId], references: [id], onDelete: Restrict)

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@map("tips")
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.VarChar(1000)
  mediaUrl  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("stories")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(32)
  text      String   @db.VarChar(280)
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity")
}

model AvatarSettings {
  id        String     @id @default(cuid())
  userId    String     @unique
  mode      AvatarMode @default(DICEBEAR)
  seed      String?
  imageData String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatar_settings")
}

// Cloud-synced user settings and data
model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  savedEvents     Json     // JSON array of saved event IDs with attendance status
  preferences     Json     // User preferences (notifications, privacy, etc.)
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Cloud-synced user activity (replaces local-only activity)
model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(32)
  text      String   @db.VarChar(280)
  refId     String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("user_activity")
}

// Off-chain map-anchored storefront. A stall is a seller's physical spot
// (with an optional radius for drops/presence). Contract address is optional
// if the owner later links an on-chain token or escrow.
model Stall {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  description String?
  latitude    Decimal   @db.Decimal(9, 6)
  longitude   Decimal   @db.Decimal(9, 6)
  radiusM     Int       @default(50)
  imageUrl    String?
  tags        String[]  @default([])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  booth       Booth?

  @@index([latitude, longitude])
  @@index([ownerId])
  @@map("stalls")
}

// Off-chain sponsored/venue space (booth) that can host drops and places.
// A booth can be attached to a stall or stand alone on the map.
model Booth {
  id          String    @id @default(cuid())
  ownerId     String
  stallId     String?   @unique
  eventId     String?
  name        String
  description String?
  latitude    Decimal   @db.Decimal(9, 6)
  longitude   Decimal   @db.Decimal(9, 6)
  radiusM     Int       @default(100)
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stall       Stall?    @relation(fields: [stallId], references: [id], onDelete: SetNull)
  event       CityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([eventId])
  @@map("booths")
}

model FriendRequest {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  fromUser   User                @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User                @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followingId String
  createdAt  DateTime @default(now())
  follower   User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following  User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

enum AvatarMode {
  DICEBEAR
  INITIALS
  UPLOAD
}

enum VisibilityMode {
  INVISIBLE
  APPROXIMATE
  EVENT_ONLY
  FRIENDS_ONLY
  VISIBLE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ProfilePrivacy {
  PUBLIC
  PRIVATE
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum DropStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CLAIMED_OUT
  CANCELLED
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // message, like, comment, reaction, follow, event_update, drop_claimed, etc.
  title     String
  body      String   @db.VarChar(280)
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Hashtag {
  id         String   @id @default(cuid())
  tag        String   @unique
  usageCount Int      @default(0)
  createdAt DateTime @default(now())
  broadcasts BroadcastHashtag[]

  @@map("hashtags")
}

model BroadcastHashtag {
  id          String   @id @default(cuid())
  broadcastId String
  hashtagId   String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  hashtag     Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, hashtagId])
  @@index([hashtagId])
  @@map("broadcast_hashtags")
}
